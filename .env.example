API_KEY=change-me

# --- LLM (generator) — pick ONE of the three options below ---

# Option A: local Ollama (free, no API key needed, slow on CPU)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434

# Option B: Anthropic Claude API (fast, intelligent, pay-per-use)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5   # fastest + cheapest (~$0.0001/query)
# ANTHROPIC_MODEL=claude-sonnet-5-5  # balanced speed + quality
# ANTHROPIC_MODEL=claude-opus-5-5    # most capable

# Option C: OpenAI API (pay-per-use, works without local Ollama — good for cloud deploy)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini           # fast + cheap (~$0.00015/1k tokens)
# OPENAI_MODEL=gpt-4o                # best quality

# --- Embeddings ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Evaluation (TruLens) ---
JUDGE_MODEL=qwen2.5:14b
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- Vector store ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sec_filings

# --- Cache ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400

# --- Web search ---
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LOG_LEVEL=INFO

# --- App / demo ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEMO_MODE=false
LOW_RAM=false

# --- Anthropic (only if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Ingestion (SEC EDGAR) ---
SEC_EDGAR_USER_AGENT=Neeraj Kumar neerajbhairav240@gmail.com   # required by SEC, no default

# --- Chunking ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100

# --- Retrieval ---
RETRIEVAL_TOP_K=10

# ── Cloud / Railway deployment ──────────────────────────────────────────────
# Use these instead of the Ollama defaults above when deploying to Railway,
# Render, or any cloud host.
#
# LLM (Anthropic — no GPU needed, fastest cold start)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5
#
# Vector store — Qdrant Cloud free tier: https://cloud.qdrant.io
# QDRANT_URL=https://<your-cluster>.aws.cloud.qdrant.io:6333
#
# Cache — Upstash Redis free tier: https://upstash.com
# REDIS_URL=rediss://:<password>@<host>.upstash.io:6380/0
#
# Optional: LangSmith tracing
# LANGSMITH_API_KEY=ls__...